# Agent Forge Environment Configuration
# Copy this file to .env and populate with actual values
# NEVER commit .env to version control

# ============================================
# Model Provider (choose one)
# ============================================
# MODEL_PROVIDER options: gemini, meta, openai, bedrock
MODEL_PROVIDER=bedrock

# Google Gemini API key for model calls
GEMINI_API_KEY=

# Meta AI API key
META_API_KEY=

# Amazon Bedrock (recommended — supports forced function calling)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514

# ============================================
# External Platforms
# ============================================

# Vapi voice assistant platform
VAPI_API_KEY=

# Make.com automation platform
MAKE_API_TOKEN=
MAKE_TEAM_ID=
MAKE_ZONE=us1

# Client-facing Supabase project (tenant data)
SUPABASE_CLIENT_URL=
SUPABASE_CLIENT_SERVICE_ROLE_KEY=

# Internal Supabase project (operational records)
SUPABASE_INTERNAL_URL=
SUPABASE_INTERNAL_SERVICE_ROLE_KEY=

# Supabase project reference for staging (optional)
SUPABASE_PROJECT_REF_STAGING=

# Hosting provider (Render or similar)
HOSTING_API_TOKEN=
HOSTING_SERVICE_ID=
HOSTING_HEALTH_URL=

# Brave Search for external research fallback
BRAVE_SEARCH_API_KEY=

# ============================================
# Local Configuration
# ============================================

# Chroma persistent directory for knowledge index
CHROMA_PERSIST_DIR=./chroma_data

# Path to reviewed server.js or backend source
SERVER_SOURCE_PATH=

# Real backend test command (required before writes)
SERVER_TEST_COMMAND=

# ============================================
# Runtime Environment
# ============================================

# Environment: staging or production
AGENT_FORGE_ENV=staging
