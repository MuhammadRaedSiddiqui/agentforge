{
  "name": "Test Staging Organization - Appointment Booking",
  "description": "Process appointment booking requests from Vapi assistant and create appointment records in the client's Supabase database",
  "teamId": "staging-make-team-001",
  "scheduling": {
    "type": "immediately"
  },
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "{{HOOK_BOOKING_ID}}",
        "dataStructure": {
          "date": "string",
          "time": "string",
          "service_type": "string",
          "client_name": "string",
          "client_phone": "string",
          "client_email": "string",
          "notes": "string"
        }
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {},
        "expect": [
          {
            "name": "date",
            "type": "text",
            "label": "Date",
            "required": true
          },
          {
            "name": "time",
            "type": "text",
            "label": "Time",
            "required": true
          },
          {
            "name": "service_type",
            "type": "text",
            "label": "Service Type",
            "required": true
          },
          {
            "name": "client_name",
            "type": "text",
            "label": "Client Name",
            "required": true
          },
          {
            "name": "client_phone",
            "type": "text",
            "label": "Client Phone",
            "required": true
          },
          {
            "name": "client_email",
            "type": "text",
            "label": "Client Email",
            "required": false
          },
          {
            "name": "notes",
            "type": "text",
            "label": "Notes",
            "required": false
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "supabase:createARow",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "{{SUPABASE_CONNECTION_ID}}"
      },
      "mapper": {
        "table": "appointments",
        "organization_id": "test_staging_org",
        "appointment_id": "APT-{{formatDate(now; \"x\")}}",
        "date": "{{1.date}}",
        "time": "{{1.time}}",
        "service_type": "{{1.service_type}}",
        "client_name": "{{1.client_name}}",
        "client_phone": "{{1.client_phone}}",
        "client_email": "{{1.client_email}}",
        "notes": "{{1.notes}}",
        "status": "confirmed",
        "created_at": "{{now}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "supabase:makeAnApiCall",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "{{SUPABASE_CONNECTION_ID}}"
      },
      "mapper": {
        "url": "/rest/v1/availability_slots?organization_id=eq.test_staging_org&date=eq.{{1.date}}&time_slot=eq.{{1.time}}",
        "method": "PATCH",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "body": "{\"is_available\": false, \"appointment_id\": \"{{2.appointment_id}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": {
        "type": "object"
      },
      "mapper": {
        "success": true,
        "appointment_id": "{{2.appointment_id}}",
        "date": "{{1.date}}",
        "time": "{{1.time}}",
        "client_name": "{{1.client_name}}",
        "organization_id": "test_staging_org",
        "message": "Appointment booked successfully"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useQuerystring": false,
        "parseResponse": true,
        "timeout": 300,
        "serializeUrl": false
      },
      "mapper": {
        "url": "{{1.__IMTHOOK__.url}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "body": "{{4.json}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": "test_staging_org_booking",
    "organization_id": "test_staging_org",
    "capability": "booking",
    "template_version": "1.1.0",
    "designer": {
      "orphans": []
    }
  },
  "_snapshot_metadata": {
    "reviewed_by": "system",
    "reviewed_at": "2026-08-13",
    "fixture": "staging_client.json",
    "notes": "This snapshot represents approved Make.com booking scenario for a staging client. Includes gateway webhook trigger, database insert (createARow) with appointment_id generated via the free formatDate(now; \"x\") expression, availability update (makeAnApiCall PATCH), and response formatting. Replaces the paid code:ExecuteCode module so the scenario activates on a free Make plan. All organization_id references correctly set to test_staging_org. Uses native Make module names and __IMTCONN__ connection parameter."
  }
}